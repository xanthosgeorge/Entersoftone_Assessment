{
  "info": {
    "name": "Entersoftone Assessment | Employee Management API",
    "_postman_id": "cffbf7a9-4d55-4b4c-9c30-bb83d3fd65ff",
    "description": "API collection for the Entersoftone .NET 10 assessment. Run folders 01 → 04 in order to create, read, update and delete your own test resources. IDs are captured into collection variables automatically after each POST. Folder 05 contains optional independent negative tests. Uses https://localhost:7020 by default; run `dotnet dev-certs https --trust` if the local certificate is untrusted. The test sequence deletes the records it creates and does not modify the seeded resources.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Setup / Create",
      "description": "Creates dependent entities and captures their IDs",
      "item": [
        {
          "name": "01 - Create Department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Departments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Assessment QA {{$timestamp}}\",\n  \"description\": \"Created by Postman Collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "if (pm.response.code === 201) {",
                  "  const result = pm.response.json();",
                  "  pm.test(\"Created ID is a GUID\", () => pm.expect(result.id).to.match(/^[a-f0-9-]{36}$/i));",
                  "  if (result.id) pm.collectionVariables.set(\"departmentId\", result.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Create Project",
