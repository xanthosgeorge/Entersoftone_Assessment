    {
      "name": "02 - Employees",
      "description": "List, retrieve, update, then delete test employee",
      "item": [
        {
          "name": "04 - List Employees (search & pagination)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Employees?search={{search}}&page={{page}}&pageSize={{pageSize}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "pm.test(\"Returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Get Employee by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Employees/{{employeeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "pm.test(\"ID matches saved employee\", () => pm.expect(pm.response.json().id.toLowerCase()).to.eql(pm.collectionVariables.get(\"employeeId\").toLowerCase()));"
                ]
              }
            }
          ]
        },
