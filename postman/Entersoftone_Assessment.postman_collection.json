              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Employees",
            "description": "Run after creating department and project; references their collection variables.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Assessment\",\n  \"lastName\": \"Tester\",\n  \"email\": \"assessment.{{$timestamp}}@example.com\",\n  \"status\": \"Active\",\n  \"hireDate\": \"2026-11-01T00:00:00\",\n  \"notes\": \"Created by Postman Collection\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"projectIds\": [\n    \"{{projectId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "if (pm.response.code === 201) {",
